#!/usr/bin/env python3
"""hc-team [folder] — start a project's agents in Herdr, each in its own tab.

Mac port of hc-agent.ps1 + .vscode/tasks.json from github.com/linyaDev/hc-board.
Like VS Code's "runOn: folderOpen": agents already running are left alone,
missing ones are started with `hc run --keep`, so they outlive Herdr and the
next call finds them again. Each agent gets its own tab; by default they share
the project's Herdr space (the one whose folder is <folder>, else a new one).
The board gets a tab in the first agent's space.

The team comes from <folder>/.herdr/team.json:

  { "board": true,
    "agents": [
      { "name": "main-claude", "role": "lead",  "run": ["claude", "--continue"] },
      { "name": "main-codex", "cwd": "server",   "run": ["codex", "resume", "--last", "--no-daemon"] } ] }

Optional per agent:
  "cwd"       its folder: absolute, ~/…, or relative to <folder>.
  "space"     the Herdr space it goes to, by name: agents with the same value
              share one, others get their own; created (and named) if missing.
              Without it: the project's space, or the worktree's.
  "worktree"  a branch: the agent runs in a git worktree of its repo on that
              branch, made like Herdr's New worktree does
              (<worktrees.directory>/<repo>/<branch>, default ~/.herdr/worktrees;
              an existing checkout of the branch is reused; a new branch starts
              at HEAD). Its subfolder ("cwd") is kept inside the worktree.
              Without "space", each worktree is a space of its own, nested
              under the repo in Herdr's sidebar.

or, when that file is missing, from <folder>/.vscode/tasks.json: every task
that calls hc-agent.ps1 is read as one agent, and one that runs hc-board.ps1
turns the board on. So the Windows projects work unchanged.

  --print   show the team and do nothing
"""
import json, os, re, subprocess, sys, time, unicodedata, uuid


def sh(*args, check=True):
    r = subprocess.run(args, capture_output=True, text=True)
    if check and r.returncode:
        raise SystemExit(f"{' '.join(args[:3])}…: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout


def jsonc(text):
    """JSON with // and /* */ comments and trailing commas (VS Code's)."""
    out, i, n, s = [], 0, len(text), None
    while i < n:
        c = text[i]
        if s:
            out.append(c)
            if c == "\\":
                out.append(text[i + 1]); i += 1
            elif c == s:
                s = None
        elif c == '"':
            s = c; out.append(c)
        elif text.startswith("//", i):
            i = text.find("\n", i); i = n if i < 0 else i; continue
        elif text.startswith("/*", i):
            i = text.find("*/", i) + 2; continue
        else:
            out.append(c)
        i += 1
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", "".join(out)))


def from_vscode(path, folder):
    team = {"board": False, "agents": []}
    for task in jsonc(open(path, encoding="utf-8-sig").read()).get("tasks", []):
        args = [str(a) for a in task.get("args", [])]
        at = next((i for i, a in enumerate(args) if a.lower().endswith("hc-agent.ps1")), None)
        if at is None:
            continue
        a = args[at + 1:]
        role = ""
        if len(a) >= 2 and a[0] == "--role":
            role, a = a[1], a[2:]
        if len(a) < 3:
            continue
        name, cwd, cmd = a[0], a[1], a[2:]
        if any(x.lower().endswith("hc-board.ps1") for x in cmd):
            team["board"] = True
            continue
        cwd = cwd.replace("${workspaceFolder}", folder)
        team["agents"].append({"name": name, "role": role, "run": cmd,
                               **({"cwd": cwd} if os.path.isdir(cwd) and cwd != folder else {})})
    return team


def load_team(folder):
    own = os.path.join(folder, ".herdr", "team.json")
    if os.path.exists(own):
        return jsonc(open(own, encoding="utf-8-sig").read()), own
    vs = os.path.join(folder, ".vscode", "tasks.json")
    if os.path.exists(vs):
        return from_vscode(vs, folder), vs
    raise SystemExit(f"no team: write {own} (see hc-team --help)")


def git(cwd, *args, check=True):
    r = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)
    if check and r.returncode:
        raise SystemExit(f"git {' '.join(args[:2])}: {r.stderr.strip() or r.stdout.strip()}")
    return r


def slug(branch):
    """Herdr's folder name for a branch (mods/worktree)."""
    name = re.sub(r"[^\w.\-]+", "-", unicodedata.normalize("NFC", branch)).strip("-")
    if name:
        return name
    h = 2166136261
    for ch in unicodedata.normalize("NFC", branch):
        h = ((h ^ ord(ch)) * 16777619) & 0xFFFFFFFF
    return f"branch-{h:08x}"


def worktrees_root():
    try:
        d = json.load(open(os.path.expanduser("~/.config/herdr-app/settings.json"))).get("worktrees", {}).get("directory")
    except Exception:
        d = None
    return os.path.expanduser(d or "~/.herdr/worktrees").rstrip("/")


def ensure_worktree(cwd, branch):
    """The checkout of <branch> for the repo at cwd (made if missing), and cwd moved into it."""
    top = git(cwd, "rev-parse", "--show-toplevel").stdout.strip()
    common = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()
    main_dir = os.path.dirname(common) if os.path.basename(common) == ".git" else top
    rel = os.path.relpath(os.path.realpath(cwd), os.path.realpath(top))
    path, current = None, None
    for line in git(cwd, "worktree", "list", "--porcelain").stdout.splitlines():
        if line.startswith("worktree "):
            current = line[9:]
        elif line == f"branch refs/heads/{branch}":
            path = current
    if not path:
        path = os.path.join(worktrees_root(), os.path.basename(main_dir), slug(branch))
        local = git(cwd, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}", check=False).returncode == 0
        remote = git(cwd, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{branch}", check=False).stdout.strip()
        # A local or remote branch is checked out (git tracks the remote one); a new one starts at HEAD.
        git(cwd, "worktree", "add", path, branch) if local or remote else git(cwd, "worktree", "add", "-b", branch, path, "HEAD")
        print(f"  worktree {branch}: {path}")
    root = os.path.realpath(path)
    return root, os.path.normpath(os.path.join(root, rel)) if rel != "." else root


def main():
    argv = sys.argv[1:]
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip()); return
    dry = "--print" in argv
    argv = [a for a in argv if a != "--print"]
    folder = os.path.realpath(os.path.expanduser(argv[0] if argv else "."))
    team, source = load_team(folder)
    agents = team.get("agents", [])
    if dry:
        print(f"{source}\nboard: {bool(team.get('board', True))}")
        for a in agents:
            where = " ".join(x for x in [a.get("cwd") and f"cwd={a['cwd']}", a.get("space") and f"space={a['space']}",
                                         a.get("worktree") and f"worktree={a['worktree']}"] if x)
            print(f"  {a['name']:<16} {a.get('role') or '-':<10} {' '.join(a['run'])}" + (f"   [{where}]" if where else ""))
        return

    live = {t.get("name"): t for t in json.loads(sh("hc", "ls", "--json"))["terminals"] if t.get("name")}
    spaces = [s for s in json.loads(sh("herdr-app", "ls"))["spaces"] if not s.get("machine")]
    by_id = {s["id"]: s for s in spaces}

    # Where each agent runs and which space group it belongs to.
    plan = []
    for a in agents:
        cwd = os.path.normpath(os.path.join(folder, os.path.expanduser(a.get("cwd") or ".")))
        if not os.path.isdir(cwd):
            print(f"  {a['name']}: no folder {cwd}, skipped"); continue
        home = folder
        if a.get("worktree"):
            home, cwd = ensure_worktree(cwd, a["worktree"])
            if not os.path.isdir(cwd):
                cwd = home
        key = ("name", a["space"]) if a.get("space") else ("folder", home)
        plan.append((a, cwd, key))

    # A group's space: where its running agents already are, else the space with
    # that name / folder, else a new one (named after "space" once it exists).
    group_space, to_name = {}, {}
    for a, _, key in plan:
        t = live.get(a["name"])
        if key in group_space or not t:
            continue
        sid = (json.loads(sh("hc", "get", t["address"], "--json")).get("labels") or {}).get("herdr.space")
        if sid in by_id:
            group_space[key] = sid
    for _, _, key in plan:
        if key in group_space:
            continue
        kind, value = key
        found = next((s for s in spaces if (s["name"] == value if kind == "name"
                      else os.path.realpath(s.get("folder") or "") == value)), None)
        group_space[key] = found["id"] if found else "spa" + uuid.uuid4().hex
        if not found and kind == "name":
            to_name[group_space[key]] = value

    shell = os.environ.get("SHELL", "/bin/zsh")
    started = []
    for a, cwd, key in plan:
        name, role, sid = a["name"], a.get("role", ""), group_space[key]
        if name in live:
            if role:
                sh("hc", "label", name, f"role={role}", check=False)
            print(f"  {name}: running ({live[name]['address']})")
            continue
        # A finished terminal would still hold the name.
        for t in json.loads(sh("hc", "ls", "--all", "--json"))["terminals"]:
            if t.get("name") == name:
                sh("hc", "rm", t["address"], check=False)
        tab = "tb" + uuid.uuid4().hex
        labels = ["--label", f"herdr.space={sid}", "--label", f"herdr.tab={tab}"]
        if role:
            labels += ["--label", f"role={role}"]
        # Through the login shell, so PATH and its functions are the person's.
        cmd = [shell, "-lic", 'exec "$@"', "hc-team"] + list(a["run"])
        out = sh("hc", "run", "--bg", "--keep", "--no-parent", "--json", "--name", name, *labels,
                 "--cwd", cwd, "--", *cmd)
        started.append((tab, role or name))
        print(f"  {name}: started ({json.loads(out).get('address', '?')}) in {cwd}")

    if started:
        time.sleep(1.5)  # Herdr adopts the new terminals
        for tab, title in started:
            sh("herdr-app", "do", "tab.rename", "--id", tab, "--name", title, check=False)
    now = {s["id"]: s for s in json.loads(sh("herdr-app", "ls"))["spaces"]}
    for sid, value in to_name.items():
        if sid in now:
            sh("herdr-app", "do", "space.rename", "--id", sid, "--name", value, check=False)
    first = group_space[plan[0][2]] if plan else None
    if team.get("board", True) and first in now and not any(t["name"] == "Board" for t in now[first]["tabs"]):
        sh("herdr-app", "do", "tab.new", "--space", first, "--mod", "hc-board", "--name", "Board", "--focus", "false", check=False)
    if first in now:
        sh("herdr-app", "do", "space.select", "--id", first, check=False)


if __name__ == "__main__":
    main()
